# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Required: Your Groq API key
# Get one free at https://console.groq.com → Create API Key
GROQ_API_KEY=your_groq_api_key_here

# Optional: Port the server listens on (default: 8080)
PORT=8080

# Optional: Price per request in USDC (default: 0.02)
PRICE_USDC=0.02
