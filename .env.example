# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Required: Your Groq API key
# Get one free at https://console.groq.com -> Create API Key
GROQ_API_KEY=your_groq_api_key_here

# Required: Base wallet address that will receive USDC payments
# This is the on-chain address clients pay before each /ai request.
# Use any EVM-compatible wallet (MetaMask, Coinbase Wallet, etc.)
PAYMENT_ADDRESS=0xYourBaseWalletAddressHere

# Optional: x402 facilitator URL (default: https://x402.org/facilitator)
# The facilitator verifies and settles payments on-chain.
# Leave unset to use the public x402.org facilitator.
FACILITATOR_URL=https://x402.org/facilitator

# Optional: x402 network (CAIP-2 format)
X402_NETWORK=eip155:8453

# Optional: Public base URL used in OpenAPI discovery
BASE_URL=https://your-api.example.com

# Optional: Ownership proof for AgentCash discovery x-discovery metadata
AGENTCASH_OWNERSHIP_PROOF=proof_xxx

# Optional: Port the server listens on (default: 8080)
PORT=8080

# Optional: Price per request in USD (default: 0.02)
PRICE_USD=0.02
# Legacy fallback still accepted:
PRICE_USDC=0.02
